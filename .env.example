# Structured [api] and [tool] logs are always emitted to stderr (no flag needed).
# To capture them: postking-mcp 2>mcp.log

# PostKing API Token (stdio / header-auth transport only)
# Get your token from https://try.postking.app (Profile > API Tokens)
# POSTKING_API_TOKEN=pk_live_your_token_here

# PostKing API Base URL
# Defaults to https://try.postking.app
# POSTKING_API_URL=https://try.postking.app

# PostKing Web (Dashboard) Base URL
# Defaults to the same origin as POSTKING_API_URL (the Next.js app serves both API and dashboard)
# Only override for custom-domain edge cases
# POSTKING_WEB_URL=https://try.postking.app

# MCP Transport mode: stdio (default) | http
# POSTKING_MCP_TRANSPORT=stdio

# Port for HTTP transport
# POSTKING_MCP_PORT=3333

# ── OAuth Resource Server (HTTP transport only) ───────────────────────────────

# Shared secret for internal token introspection.
# Must match INTERNAL_CALL_SECRET in the main PostKing app's .env.local.
# POSTKING_INTERNAL_SECRET=

# Resource URI advertised in the OAuth protected-resource metadata document.
# Default: https://mcp.postking.app/mcp
# POSTKING_RESOURCE_URI=https://mcp.postking.app/mcp

# Authorization Server issuer URL.
# Default: https://try.postking.app
# POSTKING_AS_ISSUER=https://try.postking.app

# ── Local dev example ─────────────────────────────────────────────────────────
# Uncomment all four lines when running the main PostKing app on localhost:3000.
#
# POSTKING_MCP_TRANSPORT=http
# POSTKING_MCP_PORT=3333
# POSTKING_API_URL=https://localhost:3000
# POSTKING_AS_ISSUER=https://localhost:3000
# POSTKING_RESOURCE_URI=http://localhost:3333/mcp
# POSTKING_INTERNAL_SECRET=<paste INTERNAL_CALL_SECRET from PostKing .env.local>
