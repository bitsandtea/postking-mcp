# PostKing API Token
# Get your token from https://try.postking.app (Profile > API Tokens)
POSTKING_API_TOKEN=pk_live_your_token_here

# (Optional) PostKing API Base URL
# Defaults to https://try.postking.app
# POSTKING_API_URL=https://try.postking.app

# (Optional) MCP Transport mode: stdio (default) | http
# POSTKING_MCP_TRANSPORT=stdio

# (Optional) Port for HTTP transport
# POSTKING_MCP_PORT=3333

# (Required if using http transport) Safety flag to enable remote HTTP MCP
# FF_REMOTE_MCP_ENABLED=true
